meta {
  name: Other client cannot edit
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/solicitations/{{approvedId}}/steps/basic-data
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{otherToken}}
}

body:json {
  {
    "serviceType": "INSTALLATION",
    "title": "Bruno acceptance installation",
    "description": "Install equipment at the main office for HTTP acceptance."
  }
}

tests {
  test("HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  const data = res.getBody();
  test("API error envelope", function () { expect(data.code).to.be.a("string").and.not.empty; expect(data.message).to.be.a("string").and.not.empty; expect(data.errors).to.be.an("array"); expect(Number.isNaN(Date.parse(data.timestamp))).to.equal(false); });
  test("Error code", function () { expect(data.code).to.equal("ACCESS_DENIED"); });
  
}
