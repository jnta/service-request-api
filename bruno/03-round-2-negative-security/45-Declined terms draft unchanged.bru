meta {
  name: Declined confirmation not saved
  type: http
  seq: 45
}

get {
  url: {{baseUrl}}/solicitations/{{draftId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{clientToken}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  const data = res.getBody();
  test("Workflow state", function () { expect(data.status).to.equal("DRAFT"); expect(data.currentStep).to.equal("CONFIRMATION"); });
  test("Declined confirmation was not saved", function () { expect(data.confirmation).to.equal(null); });
}
