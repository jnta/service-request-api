meta {
  name: Unsupported service type
  type: http
  seq: 30
}

put {
  url: {{baseUrl}}/solicitations/{{draftId}}/steps/basic-data
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{clientToken}}
}

body:json {
  {
    "serviceType": "CUSTOM",
    "title": "Bruno acceptance installation",
    "description": "Install equipment at the main office for HTTP acceptance."
  }
}

tests {
  test("HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  const data = res.getBody();
  test("API error envelope", function () { expect(data.code).to.be.a("string").and.not.empty; expect(data.message).to.be.a("string").and.not.empty; expect(data.errors).to.be.an("array"); expect(Number.isNaN(Date.parse(data.timestamp))).to.equal(false); });
  test("Error code", function () { expect(data.code).to.equal("VALIDATION_ERROR"); });
  test("Unsupported service type field", function () { expect(data.errors.some(e => e.field === "serviceType")).to.equal(true); });
  
}
