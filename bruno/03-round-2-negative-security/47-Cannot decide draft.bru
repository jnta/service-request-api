meta {
  name: Cannot decide draft
  type: http
  seq: 47
}

post {
  url: {{baseUrl}}/analyst/solicitations/{{draftId}}/decide
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{analystToken}}
}

body:json {
  {
    "decision": "APPROVE",
    "comment": "Too early"
  }
}

tests {
  test("HTTP 409", function () { expect(res.getStatus()).to.equal(409); });
  const data = res.getBody();
  test("API error envelope", function () { expect(data.code).to.be.a("string").and.not.empty; expect(data.message).to.be.a("string").and.not.empty; expect(data.errors).to.be.an("array"); expect(Number.isNaN(Date.parse(data.timestamp))).to.equal(false); });
  test("Error code", function () { expect(data.code).to.equal("STATE_CONFLICT"); });
  
}
