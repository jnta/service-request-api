meta {
  name: Duplicate email
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Duplicate",
    "email": "{{clientEmail}}",
    "password": "{{password}}"
  }
}

tests {
  test("HTTP 409", function () { expect(res.getStatus()).to.equal(409); });
  const data = res.getBody();
  test("API error envelope", function () { expect(data.code).to.be.a("string").and.not.empty; expect(data.message).to.be.a("string").and.not.empty; expect(data.errors).to.be.an("array"); expect(Number.isNaN(Date.parse(data.timestamp))).to.equal(false); });
  test("Error code", function () { expect(data.code).to.equal("EMAIL_ALREADY_REGISTERED"); });
  
}
