meta {
  name: Invalid confirmation unchanged
  type: http
  seq: 42
}

get {
  url: {{baseUrl}}/solicitations/{{draftId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{clientToken}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  const data = res.getBody();
  test("Workflow state", function () { expect(data.status).to.equal("DRAFT"); expect(data.currentStep).to.equal("CONFIRMATION"); });test("Response invariant", function () { expect(data.confirmation).to.equal(null); });
}
