meta {
  name: Unknown CEP
  type: http
  seq: 33
}

put {
  url: {{baseUrl}}/solicitations/{{draftId}}/steps/address
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{clientToken}}
}

body:json {
  {
    "cep": "00000000",
    "number": "123"
  }
}

tests {
  test("HTTP 422", function () { expect(res.getStatus()).to.equal(422); });
  const data = res.getBody();
  test("API error envelope", function () { expect(data.code).to.be.a("string").and.not.empty; expect(data.message).to.be.a("string").and.not.empty; expect(data.errors).to.be.an("array"); expect(Number.isNaN(Date.parse(data.timestamp))).to.equal(false); });
  test("Error code", function () { expect(data.code).to.equal("POSTAL_CODE_NOT_FOUND"); });
  
}
