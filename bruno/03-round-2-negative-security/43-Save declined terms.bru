meta {
  name: Reject declined terms at save
  type: http
  seq: 43
}

put {
  url: {{baseUrl}}/solicitations/{{draftId}}/steps/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{clientToken}}
}

body:json {
  {
    "priority": "LOW",
    "preferredDate": "{{futureDate}}",
    "estimatedValue": {
      "amount": "350.00",
      "currency": "BRL"
    },
    "termsAccepted": false
  }
}

tests {
  test("HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  const data = res.getBody();
  test("API error envelope", function () { expect(data.code).to.equal("VALIDATION_ERROR"); expect(data.message).to.be.a("string").and.not.empty; expect(data.errors).to.be.an("array"); expect(Number.isNaN(Date.parse(data.timestamp))).to.equal(false); });
  test("Terms must be accepted", function () { expect(data.errors.some(e => e.field === "termsAccepted")).to.equal(true); });
}
