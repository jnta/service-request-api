meta {
  name: Save declined terms
  type: http
  seq: 43
}

put {
  url: {{baseUrl}}/solicitations/{{draftId}}/steps/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{clientToken}}
}

body:json {
  {
    "priority": "LOW",
    "preferredDate": "{{futureDate}}",
    "estimatedValue": {
      "amount": "350.00",
      "currency": "BRL"
    },
    "termsAccepted": false
  }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  const data = res.getBody();
  test("Response invariant", function () { expect(data.confirmation.termsAccepted).to.equal(false); });
}
