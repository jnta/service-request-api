meta {
  name: Create analyst
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/admin/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "name": "Bruno analyst",
    "email": "{{analystEmail}}",
    "password": "{{password}}",
    "role": "ANALYST",
    "coverage": [
      "{{expectedState}}"
    ]
  }
}

tests {
  test("HTTP 201", function () { expect(res.getStatus()).to.equal(201); });
  const data = res.getBody();
  test("Response invariant", function () { expect(data.role).to.equal("ANALYST"); });
}
