meta {
  name: Login analyst
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{analystEmail}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const data = res.getBody();
  if (res.getStatus() === 200) {
    bru.setVar("analystToken", data.accessToken);
  }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  const data = res.getBody();
  
}
