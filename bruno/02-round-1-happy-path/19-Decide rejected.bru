meta {
  name: Decide rejected
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/analyst/solicitations/{{rejectedId}}/decide
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{analystToken}}
}

body:json {
  {
    "decision": "REJECT",
    "comment": "HTTP acceptance decision"
  }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  const data = res.getBody();
  test("Workflow state", function () { expect(data.status).to.equal("REJECTED"); });test("Response invariant", function () { expect(data.decision.outcome).to.equal("REJECT"); });
}
