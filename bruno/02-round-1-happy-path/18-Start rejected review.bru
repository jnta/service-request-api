meta {
  name: Start rejected review
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/analyst/solicitations/{{rejectedId}}/start
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{analystToken}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  const data = res.getBody();
  test("Workflow state", function () { expect(data.status).to.equal("IN_REVIEW"); });
}
