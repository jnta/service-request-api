meta {
  name: Read rejected draft
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/solicitations/{{rejectedId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{clientToken}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  const data = res.getBody();
  test("Workflow state", function () { expect(data.status).to.equal("DRAFT"); expect(data.currentStep).to.equal("BASIC_DATA"); });
}
