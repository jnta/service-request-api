meta {
  name: Decide approved
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/analyst/solicitations/{{approvedId}}/decide
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{analystToken}}
}

body:json {
  {
    "decision": "APPROVE",
    "comment": "HTTP acceptance decision"
  }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  const data = res.getBody();
  test("Workflow state", function () { expect(data.status).to.equal("APPROVED"); });test("Response invariant", function () { expect(data.decision.outcome).to.equal("APPROVE"); });
}
