meta {
  name: Read rejected terminal state
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/solicitations/{{rejectedId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{clientToken}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  const data = res.getBody();
  test("Workflow state", function () { expect(data.status).to.equal("REJECTED"); });
}
